rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Solo usuarios autenticados pueden subir/leer archivos
    match /evidencias/{allPaths=**} {
      allow read: if request.auth != null;
      // Escritura: autenticado + archivo max 10 MB + tipos permitidos
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|application/pdf|application/vnd\\.openxmlformats.*|application/msword|application/vnd\\.ms-excel.*|text/.*|video/.*');
    }

    // Bloquear todo lo demás
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

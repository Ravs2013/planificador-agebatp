rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper check for logged in users
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to check user rol
    function getUserData() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function isRole(role) {
      return isAuthenticated() && getUserData().rol == role;
    }

    function isStaff() {
      return isAuthenticated() && (getUserData().rol == 'admin' || getUserData().rol == 'jefatura' || getUserData().rol == 'personal');
    }

    function esDirectorDe(tipo, docId) {
      return isAuthenticated() && getUserData().rol == 'director' && getUserData().institucionTipo == tipo && getUserData().institucionId == docId;
    }

    // Colección usuarios:
    match /usuarios/{userId} {
      allow read: if isAuthenticated();
      allow write: if isRole('admin') || (isAuthenticated() && request.auth.uid == userId);
    }

    // Colección actividades y subcolección evidencias:
    match /actividades/{actId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
      
      match /evidencias/{evId} {
        allow read: if isAuthenticated();
        allow write: if isStaff();
      }
    }

    // Colección reuniones:
    match /reuniones/{reunionId} {
      allow read: if isAuthenticated();
      allow create: if true; // cualquiera puede solicitar reunión
      allow update, delete: if isStaff();
    }

    // Colección monitoreoSemanal y monitoreoAcumulado y esinadSemanas:
    match /monitoreoSemanal/{id} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }
    match /monitoreoAcumulado/{id} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }
    match /esinadSemanas/{id} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }

    // Colecciones de Monitoreo Docente:
    match /monitoreoDocenteEba/{id} {
      allow read: if isStaff();
      allow write: if isRole('admin') || isRole('jefatura');
    }
    match /monitoreoDocenteEtp/{id} {
      allow read: if isStaff();
      allow write: if isRole('admin') || isRole('jefatura');
    }

    // Colecciones de Monitoreo Director:
    match /monitoreoDirectorEba/{id} {
      allow read: if isStaff();
      allow write: if isRole('admin') || isRole('jefatura');
    }
    match /monitoreoDirectorEtp/{id} {
      allow read: if isStaff();
      allow write: if isRole('admin') || isRole('jefatura');
    }

    // Informes y Oficios de Monitoreo:
    match /informesMonitoreo/{id} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    // Colección directorioCeba y directorioCetpro:
    // SOLO personal/admin/jefatura y el director de la institución correspondiente pueden leer y escribir
    match /directorioCeba/{id} {
      allow read, write: if isStaff() || esDirectorDe('CEBA', id);
    }
    match /directorioCetpro/{id} {
      allow read, write: if isStaff() || esDirectorDe('CETPRO', id);
    }

    // Colección requerimientosCeba y requerimientosCetpro y matrizReferencia:
    match /requerimientosCeba/{id} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }
    match /requerimientosCetpro/{id} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }
    match /matrizReferencia/{id} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }

    function isJurado() {
      return isAuthenticated() && getUserData().rol == 'jurado';
    }

    // Módulo Juegos Florales (JFEN 2026):
    match /jfParticipantes/{id} {
      allow read: if isStaff() || isJurado();
      allow write: if isStaff() || isJurado();
    }

    match /jfEvaluaciones/{id} {
      allow read: if isStaff() || isJurado();
      allow write: if isStaff() || isJurado();
    }

    match /jfConsolidados/{id} {
      allow read: if isStaff() || isJurado();
      allow write: if isStaff();
    }

    match /jfActas/{id} {
      allow read: if isStaff() || isJurado();
      allow write: if isStaff();
    }

    // ═══════════════════════════════════════════════════════════════
    // Módulo Eureka (Feria Escolar Nacional de Ciencia y Tecnología 2026)
    //
    // La regla capital es la de eurekaEvaluaciones: una vez que el panel de firmas
    // aplicable está sellado, un no administrador ya no puede alterar un puntaje. Eso es
    // lo que da valor probatorio al consolidado suscrito por el jurado calificador.
    // ═══════════════════════════════════════════════════════════════

    function panelSellado(scopeId) {
      return exists(/databases/$(database)/documents/eurekaPanelFirmas/$(scopeId))
        && get(/databases/$(database)/documents/eurekaPanelFirmas/$(scopeId)).data.estado == 'sellado';
    }

    // Un alcance está sellado si lo está el panel específico, el de su categoría o el global.
    function alcanceSellado(categoria, areaId) {
      return panelSellado('CAT_' + categoria + '__AREA_' + areaId)
        || panelSellado('CAT_' + categoria)
        || panelSellado('GLOBAL');
    }

    match /eurekaParticipantes/{id} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }

    match /eurekaEvaluaciones/{id} {
      allow read: if isAuthenticated();
      // El evaluador autenticado captura y corrige mientras el panel siga en borrador.
      allow create: if isStaff() || isJurado();
      allow update, delete: if isRole('admin')
        || ((isStaff() || isJurado())
            && !alcanceSellado(resource.data.categoria, resource.data.areaId));
    }

    match /eurekaPanelFirmas/{scopeId} {
      allow read: if isAuthenticated();
      allow create: if isStaff();
      // La transición de 'sellado' a 'borrador' es exclusiva del administrador y exige
      // que la escritura incluya el historial con el motivo de la reapertura.
      allow update: if isRole('admin')
        || (isStaff()
            && resource.data.estado != 'sellado'
            && request.resource.data.estado != 'borrador');
      allow delete: if isRole('admin');
    }

    match /eurekaConsolidados/{id} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }

    match /eurekaActas/{id} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }

    match /eurekaJuradosEvaluadores/{dni} {
      allow read: if isAuthenticated();
      allow write: if isRole('admin') || isRole('jefatura');
    }

    // ═══════════════════════════════════════════════════════════════
    // Módulo Crea y Emprende 2026 (Etapa UGEL 03)
    // Solo la comisión y los jurados leen: los usuarios públicos no ven datos de estudiantes.
    // Con el panel de firmas sellado, un no administrador ya no altera un puntaje.
    // ═══════════════════════════════════════════════════════════════

    function cyePanelSellado(scopeId) {
      return exists(/databases/$(database)/documents/cyePanelFirmas/$(scopeId))
        && get(/databases/$(database)/documents/cyePanelFirmas/$(scopeId)).data.estado == 'sellado';
    }

    function cyeCategoriaSellada(categoria) {
      return cyePanelSellado('CAT_' + categoria) || cyePanelSellado('GLOBAL');
    }

    match /cyeParticipantes/{id} {
      allow read: if isStaff() || isJurado();
      allow write: if isStaff();
    }

    match /cyeProyectoEstado/{id} {
      allow read: if isStaff() || isJurado();
      allow write: if isStaff();
    }

    match /cyeEvaluaciones/{id} {
      allow read: if isStaff() || isJurado();
      allow create: if (isStaff() || isJurado()) && !cyeCategoriaSellada(request.resource.data.categoria);
      // Un jurado solo modifica la ficha que él capturó; la comisión puede transcribir o corregir.
      allow update: if isRole('admin')
        || (!cyeCategoriaSellada(resource.data.categoria)
            && (isStaff()
                || (isJurado() && (!('evaluadorOperativo' in resource.data)
                    || resource.data.evaluadorOperativo.uid == request.auth.uid))));
      allow delete: if isRole('admin');
    }

    match /cyePanelFirmas/{scopeId} {
      allow read: if isStaff() || isJurado();
      allow create: if isStaff();
      // La comisión guarda borradores y sella; reabrir un panel sellado es exclusivo del administrador.
      allow update: if isRole('admin') || (isStaff() && resource.data.estado != 'sellado');
      allow delete: if isRole('admin');
    }

    match /cyeConsolidados/{id} {
      allow read: if isStaff() || isJurado();
      allow write: if isStaff();
    }

    match /cyeActas/{id} {
      allow read: if isStaff() || isJurado();
      allow write: if isStaff();
    }

    match /cyeJurados/{id} {
      allow read: if isStaff() || isJurado();
      allow write: if isStaff();
    }

    match /cyeCalibracionConfig/{id} {
      allow read: if isStaff() || isJurado();
      allow write: if isStaff();
    }

    match /cyeCalibracionFichas/{id} {
      allow read: if isStaff() || isJurado();
      allow create, update: if isStaff() || (isJurado() && request.resource.data.jurado.uid == request.auth.uid);
      allow delete: if isRole('admin');
    }

    // Configuración general:
    match /config/{id} {
      allow read: if isAuthenticated();
      allow write: if isRole('admin') || isRole('jefatura');
    }

    // Libro de Reclamaciones público:
    match /reclamaciones/{id} {
      allow create: if true; // formulario de reclamos público
      allow read, update, delete: if isRole('admin');
    }
  }
}

# ══════════════════════════════════════════════════════
# Variables de Entorno — Planificador AGEBATP — UGEL 03
# ══════════════════════════════════════════════════════
# Copia este archivo como .env y llena los valores.
# NUNCA subas .env al repositorio.

# ── Firebase (Consola → Configuración del proyecto → Tus apps → SDK) ──
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Cloud Storage para evidencias ──
# true = usa Firebase Cloud Storage (requiere plan Blaze)
# false = usa n8n/Google Drive para subir evidencias
VITE_USE_FIREBASE_STORAGE=true

# ── n8n (se mantiene SOLO para notificaciones: WhatsApp, correo, Drive) ──
VITE_N8N_BASE_URL=https://tu-instancia-n8n.example.com/webhook

# ── Token secreto para autenticar webhooks de n8n ──
# Genera un token largo y aleatorio; configúralo también en n8n (header validation)
VITE_N8N_WEBHOOK_TOKEN=

# ── Firebase App Check (reCAPTCHA v3) ──
# Consola Firebase → App Check → reCAPTCHA v3 → copiar Site Key
VITE_RECAPTCHA_SITE_KEY=


